{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foodwarden",
  "main": "workers/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foodwarden-db",
      "database_id": "5331bc4a-8ed9-4017-a7ae-f493e05434e6",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "foodwarden-photos",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FRIDGE_ROOM",
        "class_name": "FridgeRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FridgeRoom"],
    },
  ],
  "triggers": {
    "crons": ["0 1 * * *"],
  },
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "https://foodwarden.newisnooby.workers.dev",
  },
}
