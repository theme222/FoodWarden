{
  "name": "foodwarden-server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run index.ts",
    "start": "bun run index.ts",
    "test": "bun test src",
    "typecheck": "bunx tsc --noEmit && bunx tsc -p workers/tsconfig.json --noEmit",
    "format": "prettier --write . ../scripts ../SECURITY-TOOLS.md ../lefthook.yml",
    "format:check": "prettier --check . ../scripts ../SECURITY-TOOLS.md ../lefthook.yml",
    "dev:dashboard": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:all": "bun run test && bun run test:ui && bun run test:worker",
    "browser": "agent-browser",
    "browser:install": "agent-browser install",
    "browser:doctor": "agent-browser doctor",
    "security:help": "deepsec --help",
    "doctor": "react-doctor . --scope full --yes",
    "doctor:security": "react-doctor . --scope full --yes --category Security",
    "hooks:install": "bun ../scripts/install-hooks.ts",
    "secrets:staged": "bun ../scripts/check-secrets.ts",
    "secrets:all": "bun ../scripts/check-secrets.ts --all",
    "lint": "oxlint src workers vite.config.ts scalar-assets.ts",
    "knip": "knip",
    "test:ui": "bun test --preload ./test/setup-dom.ts test/ui"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@scalar/api-reference": "1.78.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "agent-browser": "^0.43.0",
    "deepsec": "^2.3.12",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "lefthook": "2.2.2",
    "openapi-types": "^12.1.3",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.23",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@scalar/hono-api-reference": "^0.12.20",
    "better-auth": "^1.7.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0"
  }
}
