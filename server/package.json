{
  "name": "foodwarden-server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run index.ts",
    "start": "bun run index.ts",
    "test": "bun test src",
    "typecheck": "bunx tsc --noEmit && bunx tsc -p worker/tsconfig.json --noEmit",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "dev:dashboard": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:all": "bun run test && bun run test:worker"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "firebase-tools": "^15.35.0",
    "vite": "^7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "peerDependencies": {
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "better-auth": "^1.7.23",
    "firebase": "13.2.0",
    "hono": "^4.13.18",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7"
  }
}
