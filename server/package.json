{
  "name": "foodwarden-server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run index.ts",
    "start": "bun run index.ts",
    "test": "bun test src",
    "typecheck": "bunx tsc --noEmit && bunx tsc -p workers/tsconfig.json --noEmit",
    "format": "prettier --write . ../scripts ../SECURITY-TOOLS.md ../lefthook.yml",
    "format:check": "prettier --check . ../scripts ../SECURITY-TOOLS.md ../lefthook.yml",
    "dev:dashboard": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:dst": "bun test test/dst",
    "test:dst:cli": "bun run test/dst/run-dst.ts",
    "test:all": "bun run test && bun run test:dst && bun run test:ui && bun run test:worker",
    "browser": "agent-browser",
    "browser:install": "agent-browser install",
    "browser:doctor": "agent-browser doctor",
    "security:help": "deepsec --help",
    "doctor": "react-doctor . --scope full --yes",
    "doctor:security": "react-doctor . --scope full --yes --category Security",
    "hooks:install": "bun ../scripts/install-hooks.ts",
    "secrets:staged": "bun ../scripts/check-secrets.ts",
    "secrets:all": "bun ../scripts/check-secrets.ts --all",
    "lint": "oxlint src workers vite.config.ts scalar-assets.ts",
    "lint:type-aware": "oxlint --type-aware src workers vite.config.ts scalar-assets.ts",
    "check": "bun run typecheck && bun run lint:type-aware && bun run knip",
    "typecheck:fast": "tsrs --noEmit && tsrs -p workers/tsconfig.json --noEmit",
    "check:fast": "oxlint --type-aware --type-check src workers vite.config.ts scalar-assets.ts",
    "knip": "knip",
    "test:ui": "bun test --preload ./test/setup-dom.ts test/ui"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@fontsource/k2d": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@scalar/api-reference": "1.80.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "agent-browser": "^0.43.0",
    "deepsec": "^2.3.13",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "lefthook": "2.2.2",
    "openapi-types": "^12.1.3",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.23",
    "tailwindcss": "^4.3.5",
    "tsrs": "^0.25.0-ts7.1.0-beta",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@scalar/hono-api-reference": "^0.12.22",
    "@ui-sdk/core": "^0.1.0-beta.17",
    "@ui-sdk/react": "^0.1.0-beta.17",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.19",
    "lucide-react": "^1.74.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0"
  }
}
