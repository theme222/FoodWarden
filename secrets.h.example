// Go into the resources channel on discord to get the files.

#ifndef SECRETS_H_
#define SECRETS_H_

#include <stdint.h>

// ==============================================================================
// SmarterFridge - Microcontroller Secrets Template (C++ / ESP32)
//
// INSTRUCTIONS:
// 1. Copy this file to 'secrets.h' in the respective subsystem folder ('door/' or 'fridge/').
//    Do NOT create symlinks for secret files.
// 2. Populate with your local Wi-Fi, MQTT, and cryptographic credentials.
// 3. NEVER commit 'secrets.h' to Git (it is strictly ignored in .gitignore).
// ==============================================================================

// 1. Wi-Fi Network Credentials (Node 'F' and Node 'D')
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// 2. BLE Telemetry Encryption (Node 'F')
// 16-byte (128-bit) pre-shared AES key for AES-128-GCM application encryption.
// Must match AES_KEY in .env (represented as 32 hex characters).
static const uint8_t AES_KEY[16] = {
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
    0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F
};

// 3. MQTT over TLS Configuration (Node 'F' recalibration & Node 'D' actuation)
#define MQTT_BROKER_HOST "192.168.4.1"
#define MQTT_BROKER_PORT 8883
#define MQTT_USERNAME "smarterfridge_client"
#define MQTT_PASSWORD "YOUR_MQTT_PASSWORD"

// 4. Root Certificate Authority (CA) PEM Certificate
// Used by ESP32 WiFiClientSecure / mbedtls to authenticate the Mosquitto broker.
static const char MQTT_TLS_CA_CERT[] =
"-----BEGIN CERTIFICATE-----\n"
"MIIB/jCCAaWgAwIBAgIU...YOUR_CA_CERT_HERE...\n"
"-----END CERTIFICATE-----\n";

#endif // SECRETS_H_
