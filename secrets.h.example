// Go into the resources channel on discord to get the files.

#ifndef SECRETS_H_
#define SECRETS_H_

#include <stdint.h>

// ==============================================================================
// SmarterFridge - Microcontroller Secrets Template (C++ / ESP32)
//
// INSTRUCTIONS:
// 1. Copy this file to 'secrets.h' in the respective subsystem folder ('door/' or 'fridge/').
//    Do NOT create symlinks for actual 'secrets.h' files.
// 2. Populate the credentials required for the node you are flashing.
// 3. NEVER commit 'secrets.h' to Git (it is strictly ignored in .gitignore).
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. Node 'F' — Fridge Internal Sensor ('fridge/' via FUC.md)
//    Operates in deep sleep with zero Wi-Fi overhead; communicates strictly via
//    BLE GATT. Only requires FRIDGE_NODE_ID and AES_KEY.
// ------------------------------------------------------------------------------

// 2-character ASCII node identifier placed in TelemetryHeader.node_id ("F0")
#define FRIDGE_NODE_ID "F0"

// 16-byte (128-bit) pre-shared AES key for AES-128-GCM application encryption.
// Must match AES_KEY in .env on Gateway 'C' (represented as 32 hex characters).
static const uint8_t AES_KEY[16] __attribute__((unused)) = {
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
    0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F
};

// ------------------------------------------------------------------------------
// 2. Node 'D' — Door Closer Actuator ('door/' via CBD.md)
//    12V mains-powered actuator; connects to Gateway 'C' over Wi-Fi and MQTTS.
// ------------------------------------------------------------------------------

// 2-character node identifier included in all MQTT JSON payloads
#define DOOR_NODE_ID "D0"

// Local Wi-Fi / Hotspot Credentials (to reach Gateway 'C')
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// MQTT over TLS Broker Configuration (Mosquitto on Gateway 'C', port 8883)
// MQTT_USERNAME and MQTT_PASSWORD must match .env on Gateway 'C'.
#define MQTT_BROKER_HOST "192.168.4.1"
#define MQTT_BROKER_PORT 8883
#define MQTT_USERNAME "smarterfridge_client"
#define MQTT_PASSWORD "YOUR_MQTT_PASSWORD"

// Root Certificate Authority (CA) PEM Certificate
// Used by ESP32 WiFiClientSecure / mbedtls to verify the Mosquitto broker's TLS certificate.
static const char MQTT_TLS_CA_CERT[] __attribute__((unused)) =
"-----BEGIN CERTIFICATE-----\n"
"MIIB/jCCAaWgAwIBAgIU...YOUR_CA_CERT_HERE...\n"
"-----END CERTIFICATE-----\n";

#endif // SECRETS_H_

