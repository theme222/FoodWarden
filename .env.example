# Go into the resources channel on discord to get the files.

# ------------------------------------------------------------------------------
# 1. Edge Gateway (Node 'C' - Python / Pi-top [4])
# ------------------------------------------------------------------------------

# BLE Telemetry Decryption (Node 'F' -> Node 'C')
# 16-byte pre-shared symmetric key in hexadecimal format (32 hex characters).
# Must match AES_KEY in secrets.h.
AES_KEY=000102030405060708090a0b0c0d0e0f

# Local Mosquitto MQTT Broker over TLS (MQTTS)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=8883
MQTT_USERNAME=smarterfridge_client
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_TLS_CA_CERT=/etc/mosquitto/certs/ca.crt
MQTT_TLS_SERVER_CERT=/etc/mosquitto/certs/server.crt
MQTT_TLS_SERVER_KEY=/etc/mosquitto/certs/server.key

# Gateway Firebase Admin / Client Credentials
FIREBASE_PROJECT_ID=smarterfridge-app
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/etc/smarterfridge/serviceAccountKey.json

# ------------------------------------------------------------------------------
# 2. Cloud Backend (Server 'S' - Firebase Cloud Functions / TypeScript)
# ------------------------------------------------------------------------------

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=smarterfridge-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@smarterfridge-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=smarterfridge-app.firebasestorage.app

# Google Gemini API (Gemini 3.5 Flash Lite Multimodal VLM)
GEMINI_API_KEY=AIzaSy...YOUR_GEMINI_API_KEY_HERE

# LINE Messaging API Credentials
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_USER_ID=YOUR_LINE_USER_ID
