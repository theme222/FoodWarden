# Go into the resources channel on discord to get the files.

# ==============================================================================
# SmarterFridge - Environment Configuration Template (Python & TypeScript)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the respective subsystem folder ('camera/' or 'server/').
#    Do NOT create symlinks for actual '.env' secret files.
# 2. Populate the variables required for the subsystem you are running.
# 3. NEVER commit '.env' to Git (it is strictly ignored in .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Edge Gateway (Node 'C' - Python / Pi-top [4] in 'camera/')
# ------------------------------------------------------------------------------

# BLE Telemetry Decryption (Node 'F' -> Node 'C' via FUC.md)
# 16-byte (128-bit) pre-shared symmetric key in hexadecimal format (32 hex chars).
# Must match AES_KEY in secrets.h on Node 'F'.
AES_KEY=000102030405060708090a0b0c0d0e0f

# Local Mosquitto MQTT Broker over TLS (Node 'C' <-> Node 'D' via CBD.md)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=8883
MQTT_USERNAME=smarterfridge_client
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_TLS_CA_CERT=/etc/mosquitto/certs/ca.crt
MQTT_TLS_SERVER_CERT=/etc/mosquitto/certs/server.crt
MQTT_TLS_SERVER_KEY=/etc/mosquitto/certs/server.key

# Gateway Cloud Backend REST Client (Node 'C' <-> Server 'S' via CBS.md)
# Base HTTPS URL for Firebase Cloud Functions REST API
FIREBASE_API_BASE_URL=https://asia-southeast1-smarterfridge-app.cloudfunctions.net/api
# Permanent Bearer token generated by the Refrigerator Owner on the Web Dashboard
# (/fridges/:fridgeId/settings) and manually pasted here during one-time setup.
GATEWAY_TOKEN=sf_gw_test_secret_token_change_me_in_production

# ------------------------------------------------------------------------------
# 2. Cloud Backend (Server 'S' - Firebase Cloud Functions / Bun in 'server/')
# ------------------------------------------------------------------------------

# Firebase Admin SDK Configuration (Server-Side Firestore & Cloud Storage)
FIREBASE_PROJECT_ID=smarterfridge-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@smarterfridge-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=smarterfridge-app.firebasestorage.app

# Google Gemini API (Entity 'G' - Gemini 3.5 Flash Lite via SBG.md)
# Default/fallback API key for Cloud Functions. Individual refrigerators may also
# store a dedicated owner-configured key in Firestore (/fridges/{fridgeId}/private/config).
GEMINI_API_KEY=AIzaSy...YOUR_GEMINI_API_KEY_HERE

# LINE Messaging API Credentials (Entity 'L' via SUL.md)
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
# Default / development fallback LINE user ID for testing push notifications.
# In production, recipients are resolved per-fridge via member pairing / Firestore.
LINE_USER_ID=YOUR_LINE_USER_ID

# ------------------------------------------------------------------------------
# 3. Web Dashboard SPA (Server 'S' - Vite + React Frontend in 'server/')
# ------------------------------------------------------------------------------

# Firebase Web Modular SDK Configuration (Google SSO Auth & Firestore onSnapshot)
VITE_FIREBASE_API_KEY=AIzaSy...YOUR_FIREBASE_WEB_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=smarterfridge-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smarterfridge-app
VITE_FIREBASE_STORAGE_BUCKET=smarterfridge-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

